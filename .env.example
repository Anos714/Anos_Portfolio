# Neon Postgres connection string
DATABASE_URL=

# Canonical production URL (used for SEO / sitemap / OG images)
NEXT_PUBLIC_SITE_URL=https://portfolio-anos714.vercel.app

# Better Auth — session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub personal access token (classic) for the contribution chart.
# Server-only — never prefix with NEXT_PUBLIC_. Scopes: read:user
# (add `repo` too if you want private contributions included).
GITHUB_TOKEN=
